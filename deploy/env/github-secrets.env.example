# GitHub > Settings > Secrets and variables > Actions > *Secrets*
# (secrets, pas variables : ils donnent le droit de publier sur Vercel).

# Vercel > Account Settings > Tokens > Create
VERCEL_TOKEN=<JETON_VERCEL>
# apps/web/.vercel/project.json après « npx vercel link » (ou réglages du projet)
VERCEL_ORG_ID=<ORG_ID>
VERCEL_PROJECT_ID=<PROJECT_ID>
