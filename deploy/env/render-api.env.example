# Render > harmonie-api > Environment > Add from .env : coller ce fichier.
# PORT est fourni par Render ; ne pas le définir.

DATABASE_URL=postgresql://postgres.<REF>:<MOT_DE_PASSE_BASE>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<REF>.supabase.co
WORKER_TOKEN=<python -c "import secrets; print(secrets.token_urlsafe(32))">
CORS_ORIGINS=https://<SITE>.vercel.app
STORAGE_BACKEND=s3
S3_ENDPOINT=https://<REF>.storage.supabase.co/storage/v1/s3
S3_REGION=<REGION>
S3_BUCKET=audio
S3_ACCESS_KEY_ID=<ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
MAX_UPLOAD_MB=50
RUST_LOG=info
