# Supabase : valeurs à relever sur https://supabase.com/dashboard après la
# création du projet (aucune n'est à coller dans Supabase lui-même).
# Elles alimentent render-api.env et vercel.env. Guide : docs/DEPLOYMENT.md.

# Project Settings > General > Reference ID (ex. abcdefghijklmnopqrst)
SUPABASE_REF=<REF>
# Région du projet, telle que l'affiche Storage > S3 Connection (ex. eu-west-3)
SUPABASE_REGION=<REGION>
# Mot de passe de la base choisi à la création (gestionnaire de mots de passe)
SUPABASE_DB_PASSWORD=<MOT_DE_PASSE_BASE>

# Adresse du projet
SUPABASE_URL=https://<REF>.supabase.co
# Project Settings > API Keys > Publishable key : faite pour le navigateur
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Connect > Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.<REF>:<MOT_DE_PASSE_BASE>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Storage > New bucket : « audio », PRIVÉ
# Storage > S3 Connection > New access key (secret affiché une seule fois)
S3_ENDPOINT=https://<REF>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=<ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>

# Authentication > URL Configuration
#   Site URL      : https://<SITE>.vercel.app
#   Redirect URLs : https://<SITE>.vercel.app/analyser
