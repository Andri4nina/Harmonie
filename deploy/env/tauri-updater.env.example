# GitHub > Settings > Secrets and variables > Actions > *Secrets*
# Signature des mises à jour de l'application de bureau (gratuite).
# Générer la paire une seule fois, la clé publique va dans
# apps/desktop/src-tauri/tauri.conf.json (plugins.updater.pubkey) :
#   npx tauri signer generate -w deploy/env/tauri-updater.key
# Garder la clé privée : sans elle, les applications déjà installées ne
# pourront plus se mettre à jour.
TAURI_SIGNING_PRIVATE_KEY=<contenu de deploy/env/tauri-updater.key>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<mot de passe choisi>
