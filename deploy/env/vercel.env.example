# Site web. La construction a lieu dans GitHub Actions (le moteur WASM
# demande Rust) : créer ces valeurs comme *variables* du dépôt GitHub
# (Settings > Secrets and variables > Actions > Variables), mêmes noms.
# Si le site est un jour construit par Vercel lui-même, coller ce fichier
# dans Vercel > Settings > Environment Variables.
# Toutes ces valeurs sont publiques par nature (elles finissent dans le site).

VITE_SITE_URL=https://<SITE>.vercel.app
VITE_API_URL=https://harmonie-api.onrender.com
VITE_SUPABASE_URL=https://<REF>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Facultatif : Google Search Console > méthode « balise HTML » > valeur content
VITE_GOOGLE_SITE_VERIFICATION=
