# GitHub > Settings > Secrets and variables > Actions > *Secrets*
# Signature de l'APK Android (gratuite). Garder la clé À VIE : Android refuse
# une mise à jour signée par une autre clé. Sauvegarder le fichier .p12.
ANDROID_KEYSTORE_BASE64=<fichier .p12 encodé en base64, sur une ligne>
ANDROID_KEYSTORE_PASSWORD=<mot de passe du fichier>
ANDROID_KEY_ALIAS=harmonie
