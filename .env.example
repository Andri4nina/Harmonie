# Copier en .env (jamais versionné) et compléter.

# --- Local (docker compose) -------------------------------------------------
POSTGRES_PASSWORD=
# Secret partagé API ↔ workers, 32 caractères au moins :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

# --- Supabase (Project Settings) ---------------------------------------------
# Adresse du projet : les jetons des utilisateurs sont vérifiés avec ses clés.
SUPABASE_URL=
# Uniquement pour un projet qui signe encore ses jetons avec l'ancien secret HS256.
SUPABASE_JWT_SECRET=
# Connexion PostgreSQL (Connect > Session pooler), pour l'API hébergée :
DATABASE_URL=

# --- Stockage Supabase (Storage > S3 Connection) ----------------------------
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Site web ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
