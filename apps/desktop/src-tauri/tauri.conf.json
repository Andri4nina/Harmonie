{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmonie",
  "version": "1.7.1",
  "identifier": "app.harmonie",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run wasm && npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harmonie",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#161a2e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Andrianina Rasoamanana",
    "copyright": "© 2026 Andrianina Rasoamanana",
    "category": "Music",
    "shortDescription": "La théorie musicale sur une même carte.",
    "longDescription": "Harmonie relie notes, gammes, accords et tonalités ; elle propose des cours, un entraînement de l'oreille, un générateur de grilles et l'analyse de morceaux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNkQyNjlFMzRENTVCMDYKUldRR1c5VTBuaVp0c2tDNWxIdUMwNWZJMGlsS3pkV3NKOStCVDlkMmhJM25KN0FEUTZaSE1YZTEK",
      "endpoints": [
        "https://github.com/Andri4nina/Harmonie/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
